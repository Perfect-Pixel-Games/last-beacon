// Every socket's `rotation` encodes its outward-facing normal as local +X,
// pointing in the same direction as the socket's own position offset from
// this module's center (radially outward) -- e.g. `front` sits on the +X
// face, so its normal (already local +X, unrotated) needs no rotation.
// Connecting two modules means rotating the attaching one so its socket's
// *world* normal exactly opposes the target socket's world normal, and
// translating it so the socket positions coincide -- see
// `docs/superpowers/specs/` for the derivation. `beam.bsn` reuses this same
// six-socket, same-rotation convention so any box-shaped module can weld to
// any other consistently.
//
// Every socket also carries exactly one joint-type component
// (`LastBeaconVehicleFixedJoint` here, `LastBeaconVehicleHingeJoint` for a
// wheel's axle) -- there's no implicit default, so this is never omitted;
// see `LastBeaconVehicleModuleSocket`'s docs for why.
//
// This module's shape, rigid body kind, and mass are Bevy's/Avian3D's own
// types authored directly (see `shared/vehicle/mod.rs`'s module doc
// comment) -- `Cuboid.half_size` is half the box's width/height/depth.
//
// See docs/vehicle-authoring-guide.md's "#Tag Is Not A Comment" for what
// every `#Something` line below actually means -- it is never a comment.
last_beacon::shared::vehicle::LastBeaconVehicleModuleCuboidShape(bevy_math::primitives::dim3::Cuboid { half_size: glam::Vec3 { x: 0.5, y: 0.5, z: 0.5 } }) // Shape: a 1x1x1 box (half_size is half the full extent).
avian3d::dynamics::rigid_body::RigidBody::Dynamic // Physics body kind: a real simulated body, not static/kinematic.
avian3d::dynamics::rigid_body::mass_properties::components::Mass(40.0) // Mass in kilograms.
last_beacon::shared::vehicle::LastBeaconVehicleModuleColor(bevy_color::color::Color::Srgba(bevy_color::srgba::Srgba { red: 0.29, green: 0.42, blue: 0.55, alpha: 1.0 })) // Render color -- steel blue, purely visual.
bevy_ecs::hierarchy::Children [ // This module's six sockets (one per face), as child entities.
    #Front // This socket entity's own tag -- never read by the connection system.
    last_beacon::shared::vehicle::LastBeaconVehicleModuleSocket { socket_name: "front" } // The id a LastBeaconVehicleConnection actually matches against.
    bevy_transform::components::transform::Transform { translation: glam::Vec3 { x: 0.5, y: 0.0, z: 0.0 } } // Anchor point: +X face. No rotation needed -- local +X normal already points outward here.
    last_beacon::shared::vehicle::LastBeaconVehicleFixedJoint { }, // Joint type: a weld.

    // Normal -X: rotation of PI about Y (local +X -> world -X).
    #Back // Socket entity tag -- not read by the connection system.
    last_beacon::shared::vehicle::LastBeaconVehicleModuleSocket { socket_name: "back" } // Matched by connections referencing "back".
    bevy_transform::components::transform::Transform { translation: glam::Vec3 { x: -0.5, y: 0.0, z: 0.0 }, rotation: glam::Quat { x: 0.0, y: 1.0, z: 0.0, w: 0.0 } } // Anchor point: -X face, rotated 180 deg about Y.
    last_beacon::shared::vehicle::LastBeaconVehicleFixedJoint { }, // Joint type: a weld.

    // Normal -Z: rotation of +90 deg about Y (local +X -> world -Z).
    #Left // Socket entity tag -- not read by the connection system.
    last_beacon::shared::vehicle::LastBeaconVehicleModuleSocket { socket_name: "left" } // Matched by connections referencing "left".
    bevy_transform::components::transform::Transform { translation: glam::Vec3 { x: 0.0, y: 0.0, z: -0.5 }, rotation: glam::Quat { x: 0.0, y: 0.7071068, z: 0.0, w: 0.7071068 } } // Anchor point: -Z face, rotated +90 deg about Y.
    last_beacon::shared::vehicle::LastBeaconVehicleFixedJoint { }, // Joint type: a weld.

    // Normal +Z: rotation of -90 deg about Y (local +X -> world +Z).
    #Right // Socket entity tag -- not read by the connection system.
    last_beacon::shared::vehicle::LastBeaconVehicleModuleSocket { socket_name: "right" } // Matched by connections referencing "right".
    bevy_transform::components::transform::Transform { translation: glam::Vec3 { x: 0.0, y: 0.0, z: 0.5 }, rotation: glam::Quat { x: 0.0, y: -0.7071068, z: 0.0, w: 0.7071068 } } // Anchor point: +Z face, rotated -90 deg about Y.
    last_beacon::shared::vehicle::LastBeaconVehicleFixedJoint { }, // Joint type: a weld.

    // Normal +Y: rotation of +90 deg about Z (local +X -> world +Y).
    #Top // Socket entity tag -- not read by the connection system.
    last_beacon::shared::vehicle::LastBeaconVehicleModuleSocket { socket_name: "top" } // Matched by connections referencing "top".
    bevy_transform::components::transform::Transform { translation: glam::Vec3 { x: 0.0, y: 0.5, z: 0.0 }, rotation: glam::Quat { x: 0.0, y: 0.0, z: 0.7071068, w: 0.7071068 } } // Anchor point: +Y face, rotated +90 deg about Z.
    last_beacon::shared::vehicle::LastBeaconVehicleFixedJoint { }, // Joint type: a weld.

    // Normal -Y: rotation of -90 deg about Z (local +X -> world -Y).
    #Bottom // Socket entity tag -- not read by the connection system.
    last_beacon::shared::vehicle::LastBeaconVehicleModuleSocket { socket_name: "bottom" } // Matched by connections referencing "bottom".
    bevy_transform::components::transform::Transform { translation: glam::Vec3 { x: 0.0, y: -0.5, z: 0.0 }, rotation: glam::Quat { x: 0.0, y: 0.0, z: -0.7071068, w: 0.7071068 } } // Anchor point: -Y face, rotated -90 deg about Z.
    last_beacon::shared::vehicle::LastBeaconVehicleFixedJoint { } // Joint type: a weld.
]
