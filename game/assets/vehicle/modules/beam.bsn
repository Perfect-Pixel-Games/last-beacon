// Same six-socket, radially-outward-normal convention as `core.bsn` (see
// that file's header comment for the full derivation): `front`/`back` are
// this beam's long-axis ends (`size_x`), `left`/`right`/`top`/`bottom` are
// its four side faces. Reusing the identical convention means a beam and
// a box (like `CoreBlock`) can weld to each other -- or to another beam --
// through the same "oppose the other socket's world normal" rule, with no
// beam-specific special-casing.
//
// Every socket also carries exactly one joint-type component (see
// `core.bsn`'s header comment for why there's no implicit default).
//
// Shape/rigid-body/mass/color are Bevy's/Avian3D's own types authored
// directly, same as `core.bsn` -- `half_size` here is (1.2, 0.15, 0.15),
// half of the beam's full 2.4 x 0.3 x 0.3 size.
last_beacon::shared::vehicle::LastBeaconVehicleModuleCuboidShape(bevy_math::primitives::dim3::Cuboid { half_size: glam::Vec3 { x: 1.2, y: 0.15, z: 0.15 } }) // Shape: a 2.4 x 0.3 x 0.3 beam.
avian3d::dynamics::rigid_body::RigidBody::Dynamic // Physics body kind: a real simulated body, not static/kinematic.
avian3d::dynamics::rigid_body::mass_properties::components::Mass(10.0) // Mass in kilograms.
last_beacon::shared::vehicle::LastBeaconVehicleModuleColor(bevy_color::color::Color::Srgba(bevy_color::srgba::Srgba { red: 0.36, green: 0.38, blue: 0.21, alpha: 1.0 })) // Render color -- olive drab, purely visual.
bevy_ecs::hierarchy::Children [ // This module's six sockets (one per face), as child entities.
    #Front // This socket entity's own tag -- never read by the connection system.
    last_beacon::shared::vehicle::LastBeaconVehicleModuleSocket { socket_name: "front" } // The id a LastBeaconVehicleConnection actually matches against.
    bevy_transform::components::transform::Transform { translation: glam::Vec3 { x: 1.2, y: 0.0, z: 0.0 } } // Anchor point: +X end. No rotation needed -- local +X normal already points outward here.
    last_beacon::shared::vehicle::LastBeaconVehicleFixedJoint { }, // Joint type: a weld.

    // Normal -X: rotation of PI about Y (local +X -> world -X).
    #Back // Socket entity tag -- not read by the connection system.
    last_beacon::shared::vehicle::LastBeaconVehicleModuleSocket { socket_name: "back" } // Matched by connections referencing "back".
    bevy_transform::components::transform::Transform { translation: glam::Vec3 { x: -1.2, y: 0.0, z: 0.0 }, rotation: glam::Quat { x: 0.0, y: 1.0, z: 0.0, w: 0.0 } } // Anchor point: -X end, rotated 180 deg about Y.
    last_beacon::shared::vehicle::LastBeaconVehicleFixedJoint { }, // Joint type: a weld.

    // Normal -Z: rotation of +90 deg about Y (local +X -> world -Z).
    #Left // Socket entity tag -- not read by the connection system.
    last_beacon::shared::vehicle::LastBeaconVehicleModuleSocket { socket_name: "left" } // Matched by connections referencing "left".
    bevy_transform::components::transform::Transform { translation: glam::Vec3 { x: 0.0, y: 0.0, z: -0.15 }, rotation: glam::Quat { x: 0.0, y: 0.7071068, z: 0.0, w: 0.7071068 } } // Anchor point: -Z side face, rotated +90 deg about Y.
    last_beacon::shared::vehicle::LastBeaconVehicleFixedJoint { }, // Joint type: a weld.

    // Normal +Z: rotation of -90 deg about Y (local +X -> world +Z).
    #Right // Socket entity tag -- not read by the connection system.
    last_beacon::shared::vehicle::LastBeaconVehicleModuleSocket { socket_name: "right" } // Matched by connections referencing "right".
    bevy_transform::components::transform::Transform { translation: glam::Vec3 { x: 0.0, y: 0.0, z: 0.15 }, rotation: glam::Quat { x: 0.0, y: -0.7071068, z: 0.0, w: 0.7071068 } } // Anchor point: +Z side face, rotated -90 deg about Y.
    last_beacon::shared::vehicle::LastBeaconVehicleFixedJoint { }, // Joint type: a weld.

    // Normal +Y: rotation of +90 deg about Z (local +X -> world +Y).
    #Top // Socket entity tag -- not read by the connection system.
    last_beacon::shared::vehicle::LastBeaconVehicleModuleSocket { socket_name: "top" } // Matched by connections referencing "top".
    bevy_transform::components::transform::Transform { translation: glam::Vec3 { x: 0.0, y: 0.15, z: 0.0 }, rotation: glam::Quat { x: 0.0, y: 0.0, z: 0.7071068, w: 0.7071068 } } // Anchor point: top side face, rotated +90 deg about Z.
    last_beacon::shared::vehicle::LastBeaconVehicleFixedJoint { }, // Joint type: a weld.

    // Normal -Y: rotation of -90 deg about Z (local +X -> world -Y).
    #Bottom // Socket entity tag -- not read by the connection system.
    last_beacon::shared::vehicle::LastBeaconVehicleModuleSocket { socket_name: "bottom" } // Matched by connections referencing "bottom".
    bevy_transform::components::transform::Transform { translation: glam::Vec3 { x: 0.0, y: -0.15, z: 0.0 }, rotation: glam::Quat { x: 0.0, y: 0.0, z: -0.7071068, w: 0.7071068 } } // Anchor point: bottom side face, rotated -90 deg about Z.
    last_beacon::shared::vehicle::LastBeaconVehicleFixedJoint { } // Joint type: a weld.
]
