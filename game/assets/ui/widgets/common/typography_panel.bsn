#TypographyPanel
bevy_ui::ui_node::Node {
    width: bevy_ui::geometry::Val::Percent(100.0),
    flex_direction: bevy_ui::ui_node::FlexDirection::Column,
    align_items: bevy_ui::ui_node::AlignItems::Stretch,
}
foundation_runtime_library::ui_theme::FoundationUiThemedGap { row: foundation_runtime_library::ui_theme::FoundationUiSpaceToken::Md, column: foundation_runtime_library::ui_theme::FoundationUiSpaceToken::Zero }
foundation_runtime_library::ui_theme::FoundationUiThemedPadding { horizontal: foundation_runtime_library::ui_theme::FoundationUiSpaceToken::Xl, vertical: foundation_runtime_library::ui_theme::FoundationUiSpaceToken::Xl }
foundation_runtime_library::ui_theme::FoundationUiThemedBorderWidth(foundation_runtime_library::ui_theme::FoundationUiBorderWidthToken::Thick)
foundation_runtime_library::ui_theme::FoundationUiThemedBorderRadius(foundation_runtime_library::ui_theme::FoundationUiBorderRadiusToken::Sm)
foundation_runtime_library::ui_theme::FoundationUiThemedBackground(foundation_runtime_library::ui_theme::FoundationUiColorToken::SurfaceRaised)
foundation_runtime_library::ui_theme::FoundationUiThemedBorderColor(foundation_runtime_library::ui_theme::FoundationUiColorToken::SurfaceStrong)
bevy_ecs::hierarchy::Children [
    #TextH1
    bevy_ui::widget::text::Text("H1 / Heading One")
    foundation_runtime_library::ui_theme::FoundationUiThemedTypography(foundation_runtime_library::ui_theme::FoundationUiTypographyToken::Heading1),

    #TextH2
    bevy_ui::widget::text::Text("H2 / Heading Two")
    foundation_runtime_library::ui_theme::FoundationUiThemedTypography(foundation_runtime_library::ui_theme::FoundationUiTypographyToken::Heading2),

    #TextH3
    bevy_ui::widget::text::Text("H3 / Heading Three")
    foundation_runtime_library::ui_theme::FoundationUiThemedTypography(foundation_runtime_library::ui_theme::FoundationUiTypographyToken::Heading3),

    #TextH4
    bevy_ui::widget::text::Text("H4 / Status Label")
    foundation_runtime_library::ui_theme::FoundationUiThemedTypography(foundation_runtime_library::ui_theme::FoundationUiTypographyToken::Heading4),

    #TypographyDivider
    last_beacon::ui_widgets::LastBeaconBsnWidget { asset_path: "ui/widgets/common/divider.bsn" },

    #ParagraphText
    bevy_ui::widget::text::Text("Paragraph / Use this text style for supporting descriptions, panel copy, and compact instructions inside reusable UI surfaces.")
    foundation_runtime_library::ui_theme::FoundationUiThemedTypography(foundation_runtime_library::ui_theme::FoundationUiTypographyToken::Body)
]
